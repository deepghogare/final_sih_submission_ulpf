<group name="ulpf,siem_gateway,">
  <!-- Base Rule: All ULPF Normalized Events -->
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="event_id">\.+</field>
    <description>ULPF Gateway: Normalized universal security event ingested [$(device.vendor) - $(device.product)]</description>
  </rule>

  <!-- Informational: Permitted / Allowed Traffic -->
  <rule id="100101" level="4">
    <if_sid>100100</if_sid>
    <field name="event.action">^allow$|^allowed$|^permit$</field>
    <description>ULPF Network: Permitted connection from $(source.ip) to $(destination.ip)</description>
    <group>firewall,network,</group>
  </rule>

  <!-- Warning: Blocked / Denied Policy Violations -->
  <rule id="100102" level="7">
    <if_sid>100100</if_sid>
    <field name="event.action">^block$|^blocked$|^deny$|^denied$|^drop$|^dropped$</field>
    <description>ULPF Firewall: Blocked unauthorized connection attempt from $(source.ip) to $(destination.ip)</description>
    <mitre>
      <id>T1078</id>
      <id>T1190</id>
    </mitre>
    <group>firewall_block,pci_dss_10.6.1,</group>
  </rule>

  <!-- Critical: High / Critical Threat Severity -->
  <rule id="100103" level="10">
    <if_sid>100100</if_sid>
    <field name="event.severity">high|critical</field>
    <description>ULPF THREAT ALERT: High-severity exploit event detected ($(event.action)) from $(source.ip)</description>
    <mitre>
      <id>T1059</id>
      <id>T1210</id>
    </mitre>
    <group>exploit,threat_detected,</group>
  </rule>

  <!-- Forensic Audit Alarm: Blockchain Ledger Tamper Alarm -->
  <rule id="100104" level="14">
    <if_sid>100100</if_sid>
    <field name="integrity.tamper_status">detected</field>
    <description>ULPF BLOCKCHAIN ALARM: Forensic chain-of-custody violation detected at Block #$(blockchain.block_index)!</description>
    <group>integrity_failure,tamper_alarm,</group>
  </rule>
</group>
